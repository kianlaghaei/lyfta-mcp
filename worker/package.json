{
  "name": "@kian/lyfta-personal-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Lyfta MCP integration on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
